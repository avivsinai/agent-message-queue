      "name": "plain-text",
      "command": {
        "schema": "amq.remote.command/1",
        "op": "request.submit",
        "request_id": "11111111-1111-4111-8111-111111111d01",
        "target_id": "t_fake1",
        "epoch": "e_1",
        "not_after": "2026-09-08T10:02:00Z",
        "input": {
          "text": "say hi"
        }
      },
      "expect_sha256": "sha256:ffd4ffc2828b163a89726f19bd04b947b10bb9fce3d617010fa105b93c3d096c",
      "note": "baseline plain text, Z suffix"
    },
