        "request_id": "11111111-1111-4111-8111-111111111d01",
        "target_id": "t_fake1",
        "epoch": "e_1",
        "not_after": "2026-09-08T10:02:00Z",
        "input": {
          "text": "say hi"
        }
      },
      "expect_sha256": "sha256:a559be7bd0d1746f960afb4b5cd020339a12c0bcfe1f68ab68195ee0e64b585e",
      "note": "baseline plain text, Z suffix"
