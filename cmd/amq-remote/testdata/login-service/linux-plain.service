# written by amq-remote service install
[Unit]
Description=AMQ Remote endpoint for /Users/a/proj

[Service]
ExecStart="/opt/homebrew/bin/amq-remote" up --root "/Users/a/proj"
Environment="PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
