<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.avivsinai.amq-board.8dc00cb6</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/amq-board</string>
		<string>sync</string>
		<string>--watch</string>
		<string>--session</string>
		<string>review</string>
		<string>--notify</string>
		<string>lead,alt</string>
		<string>--as</string>
		<string>floor</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
