  "components": [
    {
      "name": "Copy Button",
      "kind": "button",
      "refersTo": "button",
      "description": "A written action with visible hover and focus.",
      "html": "<button class=\"ds-button\">Copy command</button>",
      "css": ".ds-button{font-family:var(--font-ui);min-height:2.75rem;padding:.625rem .875rem;border:1px solid var(--control);border-radius:.5rem;background:var(--surface);color:var(--accent);font-size:.9375rem;font-weight:600;line-height:1.3334;cursor:pointer}.ds-button:hover{background:var(--selected)}.ds-button:active{background:var(--subtle)}.ds-button:focus-visible{outline:3px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search",
      "description": "A labeled field for the visible view.",
      "html": "<label class=\"ds-search\">Search Next<input type=\"search\" placeholder=\"Title, person, or reference\"></label>",
      "css": ".ds-search{font-family:var(--font-ui);display:grid;gap:.5rem;color:var(--muted);font-size:.875rem}.ds-search input{font:inherit;font-size:1rem;min-height:2.75rem;padding:.625rem .75rem;border:1px solid var(--control);border-radius:.5rem;background:var(--surface);color:var(--ink)}.ds-search input::placeholder{color:var(--muted)}.ds-search input:focus-visible{outline:3px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "View Navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "A selected destination with adjacent context.",
      "html": "<nav class=\"ds-nav\"><a href=\"#next\" aria-current=\"page\">Next</a><a href=\"#work\">Work</a></nav>",
      "css": ".ds-nav{font-family:var(--font-ui);display:grid;gap:.25rem}.ds-nav a{min-height:2.75rem;padding:.6875rem .875rem;border-radius:.5rem;font-size:.9375rem;font-weight:600;line-height:1.4667;color:var(--muted);text-decoration:none}.ds-nav a:hover{background:var(--subtle);color:var(--ink)}.ds-nav a[aria-current]{background:var(--selected);color:var(--accent)}.ds-nav a:focus-visible{outline:3px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Work List",
      "kind": "card",
      "refersTo": "work-list",
      "description": "Shared reading surface with a title and reason.",
      "html": "<article class=\"ds-list\"><h2>Review the proposed change</h2><p>A review request needs your response.</p></article>",
      "css": ".ds-list{font-family:var(--font-ui);border:1px solid var(--divider);border-radius:.75rem;padding:1.25rem 1.5rem;background:var(--surface);color:var(--ink)}.ds-list h2{margin:0;font-size:1.125rem;font-weight:600;line-height:1.4445}.ds-list p{margin:.5rem 0 0;font-size:1rem;line-height:1.5}"
    },
    {
      "name": "Coverage Disclosure",
      "kind": "custom",
      "refersTo": "coverage",
      "description": "Compact warning with an explanation on demand.",
      "html": "<details class=\"ds-coverage\"><summary>Incomplete coverage</summary><p>Read Sources for the missing scope.</p></details>",
      "css": ".ds-coverage{font-family:var(--font-ui);background:var(--warning-bg);color:var(--warning);padding:.875rem 1rem;border-radius:.5rem;font-size:.875rem;line-height:1.5}.ds-coverage summary{cursor:pointer;font-weight:600;min-height:1.5rem;padding-block:.625rem;width:fit-content}.ds-coverage summary:hover{text-decoration:underline}.ds-coverage summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px;}.ds-coverage p{margin:.75rem 0 0}"
    },
    {
      "name": "Command Field",
      "kind": "input",
      "refersTo": "command",
      "description": "Selectable readonly command in inline context.",
      "html": "<label class=\"ds-command\">Inspect source<textarea readonly rows=\"2\" spellcheck=\"false\">amq --help</textarea></label>",
      "css": ".ds-command{font-family:var(--font-ui);display:grid;gap:.5rem;color:var(--muted);font-size:.875rem}.ds-command textarea{width:100%;min-height:4.5rem;resize:vertical;padding:.75rem;border:1px solid var(--control);border-radius:.5rem;background:var(--surface);color:var(--ink);font-family:var(--font-code);font-size:.875rem;line-height:1.5}.ds-command textarea:focus-visible{outline:3px solid var(--accent);outline-offset:3px;}"
    },
    {
      "name": "Suggestion Review",
      "kind": "custom",
      "description": "A quoted source span with interpretations and provenance on demand.",
      "html": "<article class=\"ds-suggestion\"><h2>Review interpretation</h2><blockquote>Quoted source text</blockquote><ul><li>Attach to an existing task</li></ul><details><summary>Review evidence and commands</summary><p>Exact source span and available terminal commands.</p></details></article>",
      "css": ".ds-suggestion{font-family:var(--font-ui);padding:1.25rem 1.5rem;overflow-wrap:anywhere;color:var(--ink)}.ds-suggestion h2{margin:0;font-size:1.125rem;font-weight:600;line-height:1.4445}.ds-suggestion blockquote{margin:1rem 0;max-width:66ch;white-space:pre-wrap}.ds-suggestion ul{padding-left:1.25rem}.ds-suggestion li+li{margin-top:.5rem}.ds-suggestion details{margin-top:.75rem}.ds-suggestion summary{cursor:pointer;display:block;width:fit-content;min-height:2.75rem;padding-block:.625rem;color:var(--accent);font-size:.9375rem;line-height:1.5}.ds-suggestion summary:hover{text-decoration:underline;text-underline-offset:.2em}.ds-suggestion summary:focus-visible{outline:3px solid var(--accent);outline-offset:3px;}.ds-suggestion details[open]>p{margin-top:.75rem;padding:1rem;border-radius:.5rem;background:var(--subtle)}"
    }
  ],
  "narrative": {
    "northStar": "The Work Navigator",
    "overview": "The Work Navigator uses a cool neutral canvas, a clear list surface, and restrained cobalt selection. A system sans supports reading; monospace identifies commands and references. Fine dividers and generous rows keep separate records easy to scan.\n\nInline disclosures reveal context in place. Suggestions show quoted source spans and interpretations separately from tasks; Details exposes provenance and available terminal commands. Color supports written state: warnings explain missing coverage, and errors identify failed operations. Local font stacks and CSS carry the system without external assets.",
    "keyCharacteristics": [
      "One reading lane with a secondary navigation rail.",
      "Readable titles, body text, and metadata at distinct sizes.",
      "Flat surfaces, fine dividers, and restrained cobalt selection.",
      "Native inline disclosures and visible keyboard focus.",
      "Separate destinations for Suggestions and History."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "State is stated in words; color reinforces the words.",
        "section": "colors"
      },
      {
        "name": "The Reading Size Rule",
        "body": "Compact layouts reflow rows and controls without reducing body or metadata type.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use surface tones and fine dividers for grouping; the system has no shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep command text selectable and show a written copy result.",
      "Do use inline disclosure for evidence and secondary context.",
      "Do preserve readable type when the layout becomes one column."
    ],
    "donts": [
      "Don't use color alone to identify status.",
      "Don't add flight-strip cells, condensed micro-labels, or a wall of cards.",
      "Don't hide the keyboard focus outline."
    ]
  }
}
